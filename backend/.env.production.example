# Variables de entorno para PRODUCCION del backend (FastAPI)
#
# Copiar a backend/.env EN EL SERVIDOR (nunca commitear el .env real):
#   cp .env.production.example .env
#
# Este backend NO almacena datos clinicos, NO usa base de datos y NO tiene
# autenticacion. Aun asi, trata este archivo como sensible y restringe permisos:
#   chmod 600 backend/.env

# Desactiva modo debug en produccion
DEBUG=false

# Origenes permitidos para CORS, en formato lista JSON.
# Debe contener el dominio del frontend en produccion.
# IMPORTANTE: en backend/compose.yaml la clave `environment.ALLOWED_ORIGINS`
# tiene prioridad sobre este archivo. Para produccion, deja que el valor venga
# de aqui (quita o ajusta esa linea en compose) o ponlo igual en ambos lados:
ALLOWED_ORIGINS=["https://medico.entaltek.com"]
